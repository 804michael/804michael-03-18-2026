# Cloudflare Pages, by default, caches static assets aggressively at the
# edge (nav.css was observed being served with "public, max-age=14400" —
# 4 hours — with no _headers file setting that explicitly). During active
# development, that means a pushed fix can take up to 4 hours to actually
# reach a visitor's browser, which reads as "the fix didn't work" even
# though the deployed file is correct. This shortens it to 5 minutes for
# the files that change most often (the shared nav/banner and the pages
# actively being iterated on) so pushes show up close to immediately.
#
# Once the site design stabilizes, these can be safely raised again (or
# removed, to fall back to Cloudflare's longer defaults) for better
# caching performance.

/nav.css
  Cache-Control: public, max-age=300, must-revalidate

/nav.js
  Cache-Control: public, max-age=300, must-revalidate

/nav-partial.html
  Cache-Control: public, max-age=300, must-revalidate

/*.html
  Cache-Control: public, max-age=300, must-revalidate

# Client tour links (/t/<code>) must never be cached by the browser.
#
# Added 2026-09-05 after a real failure: while the /t/* rule still pointed at
# /client-tour.html, Cloudflare's own .html -> extensionless rule fired on top
# of it and answered with a 308 PERMANENT redirect to /client-tour, which drops
# the tour code. Browsers cache a 308 indefinitely, per URL, so even after the
# server was fixed, any phone that had opened a tour link during that window
# kept redirecting itself to the code-less URL without ever asking the server
# again - the link looked permanently broken to that one person and fine to
# everyone else. no-store stops a redirect on these URLs from ever being
# remembered, so a future routing mistake can't strand a client the same way.
/t/*
  Cache-Control: no-store

# Shared HTML fragments must not be indexed (added 2026-09-06).
#
# nav-partial.html and Unified_footer.html are not pages. They are fetched by
# JS and injected into real pages (nav.js does `placeholder.outerHTML = html`).
# Requested on their own they render as a bare nav or a bare footer with no
# hero, no content and no context - precisely the thin, duplicate-ish page
# Google should never list under this domain. Both are publicly fetchable and
# neither carries a canonical tag, so nothing was stopping that.
#
# This MUST be an HTTP header. It must NOT be a <meta name="robots"> inside
# either file. Everything in nav-partial.html is injected into the DOM of
# EVERY page on the site, Google honours a noindex it finds after rendering,
# and a meta tag there would therefore deindex the entire site. An HTTP header
# applies only to a direct request for these URLs, so it cannot leak into the
# pages that include them.
#
# nav-partial.html also appears above with a Cache-Control rule. Cloudflare
# Pages applies every matching rule, and these are different header names, so
# both take effect.
/nav-partial.html
  X-Robots-Tag: noindex

/Unified_footer.html
  X-Robots-Tag: noindex

# The extensionless twins (added 2026-09-11). Cloudflare Pages answers
# /nav-partial.html with a 308 to /nav-partial, and _headers rules match the
# path actually served, so the two .html rules above never reached the
# response anyone received: the live fragment went out with no noindex and
# no 5-minute cache. nav.js now fetches /nav-partial directly (skipping that
# redirect), which makes these the rules that matter. The .html versions
# stay for anything still requesting the old name.
/nav-partial
  Cache-Control: public, max-age=300, must-revalidate
  X-Robots-Tag: noindex

/Unified_footer
  X-Robots-Tag: noindex
