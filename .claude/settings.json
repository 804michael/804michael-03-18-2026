{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/auto-commit.sh\"",
            "timeout": 30,
            "statusMessage": "Committing changes..."
          }
        ]
      }
    ]
  }
}
